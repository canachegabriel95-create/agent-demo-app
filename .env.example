# Copy to .env (git-ignored) and replace the placeholder values:
#   cp .env.example .env
# Never commit .env or real credentials.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_DB=content_review
# Must match the "Username" in docker/pgadmin/servers.json unless you edit that file.
POSTGRES_USER=content_review
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# --- pgAdmin (docker-compose.yml) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-local-only
PGADMIN_PORT=5050

# --- Initial administrator (scripts/provision-admin.sh / .ps1) ---
# Placeholders only. The password is typed into a hidden prompt and is never stored here.
ADMIN_EMAIL=admin@example.local
ADMIN_NAME=Platform Admin

# --- API (ASP.NET Core reads these as environment variables) ---
# Use the same user/password as above.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=content_review;Username=content_review;Password=change-me-local-only

# --- API optional settings (ASP.NET Core env var form: double underscore = ":") ---
# Apply EF Core migrations at API startup. Default: true in Development, false otherwise.
#Database__MigrateOnStartup=true
# Origins allowed by CORS. Defaults (the two portals) live in backend/src/ContentReview.Api/appsettings.json.
#Cors__AllowedOrigins__0=http://localhost:5173
#Cors__AllowedOrigins__1=http://localhost:5174
# Session token lifetime in hours (default 8).
#Auth__SessionLifetimeHours=8
# Login attempts allowed per client IP and minute before the API answers 429 (default 10).
#Auth__LoginAttemptsPerMinute=10
