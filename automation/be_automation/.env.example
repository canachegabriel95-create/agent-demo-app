# Copy to .env (git-ignored) or export in the shell. No real credentials here.
API_BASE_URL=http://localhost:5080
# An administrator that already exists (see scripts/provision-admin.sh).
API_ADMIN_EMAIL=admin@example.local
API_ADMIN_PASSWORD=
# Direct database access, used only to delete the data the tests created once the run ends.
API_DB_CONNECTION=postgresql://content_review:<password>@localhost:5432/content_review
