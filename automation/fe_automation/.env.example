# Copy to .env (git-ignored) and fill in. Never commit .env.

# --- Portals ---
ADMIN_PORTAL_URL=http://localhost:5173
AUTHOR_PORTAL_URL=http://localhost:5174

# --- QA accounts ---
QA_ADMIN_EMAIL=qa.admin@example.com
QA_ADMIN_PASSWORD=change-me
QA_AUTHOR_EMAIL=qa.author@example.com
QA_AUTHOR_PASSWORD=change-me

# --- Database (same values as the repo-root .env) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=content_review
POSTGRES_USER=content_review
POSTGRES_PASSWORD=change-me
