{
  "description": "Shared by the xUnit tests (PasswordPolicy) and the Vitest tests (Author Portal passwordPolicy.ts). `violations` lists the broken rules in this order: TooShort, TooLong, MissingUppercase, MissingLowercase, MissingDigit, MissingSymbol. A password is given either directly (`password`, null allowed) or built with `build`: `prefix` followed by `fill` repeated up to `length` UTF-16 code units.",
  "cases": [
    { "name": "typical valid password", "password": "Str0ng!Passw0rd", "violations": [] },
    { "name": "valid at exactly 12 characters", "password": "aA1!aaaaaaaa", "violations": [] },
    { "name": "valid at exactly 128 characters", "build": { "prefix": "Aa1!", "fill": "x", "length": 128 }, "violations": [] },
    { "name": "129 characters is too long", "build": { "prefix": "Aa1!", "fill": "x", "length": 129 }, "violations": ["TooLong"] },
    { "name": "11 characters is too short", "password": "Aa1!aaaaaaa", "violations": ["TooShort"] },
    { "name": "empty string breaks every rule except TooLong", "password": "", "violations": ["TooShort", "MissingUppercase", "MissingLowercase", "MissingDigit", "MissingSymbol"] },
    { "name": "null is treated as empty", "password": null, "violations": ["TooShort", "MissingUppercase", "MissingLowercase", "MissingDigit", "MissingSymbol"] },
    { "name": "no uppercase", "password": "str0ng!passw0rd", "violations": ["MissingUppercase"] },
    { "name": "no lowercase", "password": "STR0NG!PASSW0RD", "violations": ["MissingLowercase"] },
    { "name": "no digit", "password": "Strong!Password", "violations": ["MissingDigit"] },
    { "name": "no symbol", "password": "Str0ngPassw0rds", "violations": ["MissingSymbol"] },
    { "name": "a space is not a symbol", "password": "Str0ng Passw0rd", "violations": ["MissingSymbol"] },
    { "name": "a tab is not a symbol", "password": "Str0ng\tPassw0rd", "violations": ["MissingSymbol"] },
    { "name": "a non-breaking space is not a symbol", "password": "Str0ng Passw0rd", "violations": ["MissingSymbol"] },
    { "name": "underscore is a symbol", "password": "Str0ng_Passw0rd", "violations": [] },
    { "name": "emoji is a symbol and counts as two code units", "password": "Str0ngPassw0rd😀", "violations": [] },
    { "name": "accented upper and lower case letters count", "password": "Éclair1!éclair", "violations": [] },
    { "name": "only accented uppercase letters", "password": "ÉCLAIR1!ÉCLAIR", "violations": ["MissingLowercase"] },
    { "name": "a non-ASCII decimal digit counts as a digit", "password": "Abcdefghijk٣!", "violations": [] },
    { "name": "letters of other scripts are letters but neither upper nor lower", "password": "密码密码密码密码密码密码1!", "violations": ["MissingUppercase", "MissingLowercase"] },
    { "name": "short and missing classes together", "password": "short", "violations": ["TooShort", "MissingUppercase", "MissingDigit", "MissingSymbol"] },
    { "name": "very long without classes", "build": { "prefix": "", "fill": "a", "length": 200 }, "violations": ["TooLong", "MissingUppercase", "MissingDigit", "MissingSymbol"] }
  ]
}
